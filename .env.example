# Demo uses rules only; enabling NVIDIA is an explicit, separate opt-in.
INCIDENTLAB_COACH_MODE=rules
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
# hosted (default) or brev. Keep all values server-only.
NVIDIA_DEPLOYMENT=hosted

# For the prepared self-hosted Brev gateway, replace the three values above:
# NVIDIA_DEPLOYMENT=brev
# NVIDIA_API_KEY=<your-own-gateway-token, not a Brev account API key>
# NVIDIA_BASE_URL=https://<your-gateway-host>/v1
# NVIDIA_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2
